#7. Магические методы __setattr__, __getattribute__, __getattr__ и __delattr__ | ООП Python
# 1) работа с атрибутами экземпляра и атрибутами всего КЛАССА @classmethod

# 2) магические методы ( dunder-методы) представляют собой специальные методы, которые начинаются и заканчиваются двумя подчеркиваниями (например, __init__, __str__). Эти методы позволяют вам определять поведение ваших объектов при использовании встроенных функций и операторов.

####### 1 ####### работа с атрибутами экземпляра и атрибутами класса

class Point:
    MIN_COORD = 0
    MAX_COORD = 100
    
    def __init__(self,x,y):
        self.x= x
        self.y= y
        
    def set_coord(self,x,y):
        self.x=x
        self.y=y
        
    def set_new_attr(self,left): # метод который создаст новое локальное свойсво экземпляра
        self.MIN_COORD = left # в результате у экземпляра создаться новый атр. с таким же названием как у атрибута класса
        
    @classmethod # используем классметод для изменения/обращения/добавлеения к атрибутам класса
    def set_class_attr(self,left): # вместо self правильнее прописать cls, если мы обращаемся к атрибутам класса
        self.MIN_COORD = left  # вместо self правильнее прописать cls
        self.MAX_COORD = left+301  # вместо self правильнее прописать cls
        

pt1 = Point(1,2)
pt2 = Point(10,20)
pt1.set_new_attr(-100) # через ф-ции не задекорированые как @classmethod мы будем обращаться к атрибутам экземпляра класса
print('pt1:',pt1.__dict__)
print('pt2:',pt2.__dict__)
print('Point:',Point.__dict__)
# таким образом был создан атрибут у экземпляра а не изменён у класса 
# а нам надо изменить у класса 

pt2.set_class_attr(-100) # через ф-ции классметода мы имеем доступ к атрибутам класса (добавление/изменение/удаление - что пропишем) и обращаться можно через экземпляры класса или напрямую через имя класса
# pt2.set_class_attr(-100)  равно Point.set_class_attr(-100) 
# только если экземпляр класса обращаемся .. то пайтон ищет метод(ф-цию) сначала в атрибутах этого экземпляра,а потом у родителя этого класса.
print(Point.__dict__)

####### 2 ####### как только идёт обращение к какому-либо атрибуту через экземпляр класса - вызывается соответсвующий магический метод (создание,чтение/изменение,удаление)
class Point3:
    MIN_COORD = 0
    MAX_COORD = 100
    
    def __init__(self,x=0,y=0):
        self.x= x
        self.y= y
        
    def set_coord(self,x,y):
        self.x=x
        self.y=y

#2.1 - вызывается автоматически __getattribute__ при получении атрибута у класса
    def __getattribute__(self,item): # мы можем переопределить эти методы для каждого класса самостоятельно, но изначально этот метод вызывается из базового класса object
        if item == 'x' or item == 'y' or item == '__dict__' or item == 't': # здесь прописываем условия какие атрибуты мы можем читать
            print('только что прочитали атрибут у экземпляра:', item)
            return object.__getattribute__(self,item)
        else:
            raise ValueError('запрещён доступ к такому атрибуту: ',item)
            
# 2.2 -  вызывается  __getattr__() при получении доступа к несуществующему атрибутуу
    def __getattr__(self,item):
        print('вызов __getattr__ т.к. не сущетсвует атрибут:',item)
        return False # переопределив этот метод можно получать к примеру False если атрибута нету
            
# 2.3 - вызов метода __setattr__ автоматически при изменении атрибутов класса
    def __setattr__(self,key,value):
        if key == 'z': 
            print("raise AtributeError('недопустимое имя атрибута:',key)")
        else:
            print("вызвов __setattr__ чтобы установить ", key,'=', value)
            object.__setattr__(self,key,value)#лучше через object # если переписать эту строчку вот так: self.x = value ,- то будет рекурсия т.е. постоянно будет вызываеться метод __setattr__ 
            
            #self.x = value 
            # >>> RecursionError: maximum recursion depth exceeded
            # self.__dict__[key] = value # вот так вот будет правильнее так можно делать но тогда надо разрешить читать '__dict__' в  __getattribute__
  
# 2.4 - удаление атриьбутов
    def __delattr__(self,item):
        print ('вызов__delattr__ для:' + item)
        object.__delattr__(self,item)
          

pt3 =  Point3(3,33)

# 2.1
a=pt3.x  # обращаясь к атрибутам экземпляра автоматически вызывается дандер метод __getattribute__ (и мы его переопределили так что печатается сообщение)
# 2.2
a=pt3.t # вызываем атрибут 't' и присваемем а = False т.к. этого атрибута нет
print(a)
# 2.3
pt3.z = 1000
# 2.4
del pt3.y
print(pt3.__dict__)

