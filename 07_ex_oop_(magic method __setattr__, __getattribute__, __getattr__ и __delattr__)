#7. Магические методы __setattr__, __getattribute__, __getattr__ и __delattr__ | ООП Python
# 1) работа с атрибутами экземпляра и атрибутами всего КЛАССА @classmethod

# 2) магические методы ( dunder-методы) представляют собой специальные методы, которые начинаются и заканчиваются двумя подчеркиваниями (например, __init__, __str__). Эти методы позволяют вам определять поведение ваших объектов при использовании встроенных функций и операторов.

####### 1 ####### работа с атрибутами экземпляра и атрибутами класса

class Point:
    MIN_COORD = 0
    MAX_COORD = 100
    
    def __init__(self,x,y):
        self.x= x
        self.y= y
        
    def set_coord(self,x,y):
        self.x=x
        self.y=y
        
    def set_new_attr(self,left): # метод который создаст новое локальное свойсво экземпляра
        self.MIN_COORD = left # в результате у экземпляра создаться новый атр. с таким же названием как у атрибута класса
        
    @classmethod # используем классметод для изменения/обращения/добавлеения к атрибутам класса
    def set_class_attr(self,left): # вместо self правильнее прописать cls, если мы обращаемся к атрибутам класса
        self.MIN_COORD = left  # вместо self правильнее прописать cls
        self.MAX_COORD = left+301  # вместо self правильнее прописать cls
        

pt1 = Point(1,2)
pt2 = Point(10,20)
pt1.set_new_attr(-100) # через ф-ции не задекорированые как @classmethod мы будем обращаться к атрибутам экземпляра класса
print('pt1:',pt1.__dict__)
print('pt2:',pt2.__dict__)
print('Point:',Point.__dict__)
# таким образом был создан атрибут у экземпляра а не изменён у класса 
# а нам надо изменить у класса 

pt2.set_class_attr(-100) # через ф-ции классметода мы имеем доступ к атрибутам класса (добавление/изменение/удаление - что пропишем) и обращаться можно через экземпляры класса или напрямую через имя класса
# pt2.set_class_attr(-100)  равно Point.set_class_attr(-100) 
# только если экземпляр класса обращаемся .. то пайтон ищет метод(ф-цию) сначала в атрибутах этого экземпляра,а потом у родителя этого класса.
print(Point.__dict__)
