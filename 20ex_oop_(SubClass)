# Насследование классов  -  позволяет получить новый класс, немного отличающийся от базового (с новыми свойствами и методами).
#1) наследование происходить от базового класса
#2) когда происходит обращение к какому-либо атрибуту класса - поиск просиходит сначала в том классе в котором вызвывали, а потом если не находит то в базовом 
#3) В дочернем классе можно вызывать методы из базового класса, если такой метод в нем не определен.

class Geom(): # базовый класс
    name = 'Имя Базового класса'
    def set_coords(self, x1, x2, y1, y2):
        self.x1 = x1
        self.x2 = x2
        self.y1 = y1 
        self.y2 = y2
    def photo(self):
        print("Фото в базовом классе")
        
class Line(Geom): # дочерний класс Line от базового Geom
    #name='Имя линия'
    def draw(self):
        print("Рисование линии")

    # def set_coords(self, x1, y1, x2, y2) - перенесли в базовый класс
    #     self.x1 = x1
    #     self.x2 = x2
    #     self.y1 = y1 
    #     self.y2 = y2

class Rectangle(Geom):  # дочерний класс Rectangle от базового Geom
    name='Имя прямоугольник' # переопределяем атрибута
    def draw(self):
        print("Рисование прямоугольника")
        
    def photo(self):
        print("Фото в классе Rectangle")    
   
    # def set_coords(self, x1, y1, x2, y2) - перенесли в базовый класс
    #     self.x1 = x1
    #     self.x2 = x2
    #     self.y1 = y1 
    #     self.y2 = y2  
    
    def set_coords(self, x1, y1, x2, y2): #-переопределение метода set
        self.x1 = x1
        self.x2 = x2
        self.y1 = y1 
        self.y2 = y2

g = Geom()
l = Line()
r = Rectangle()
l.set_coords(1,1,2,2)
r.set_coords(1,1,2,2)
print(l.__dict__)
print(r.__dict__)
print(l.name)
print(r.name)
# когда происходит обращение к какому-либо атрибуту - поиск просиходит сначала в том классе в котором вызвывали, а потом если не находит то в базовом 
l.draw()
r.draw()
# В дочернем классе можно вызывать методы из базового класса, если такой метод в нем не определен.
x = Rectangle()
x.set_coords(1,1,2,2)
x.photo()

z = Line()
z.set_coords(1,1,2,2)
z.photo() # этого метода нет в классе Line поэтому этот метод будет искаться в базовом классе, если его не будет - выскочит ошибка
# ---------------- 21EX_OOP --------------------
print(issubclass(Geom,object)) # ghj
print(issubclass(Line,object))
print(issubclass(Rectangle,object))
print(issubclass(Geom,Line))
print('------')
#print(issubclass(l,Line)) #ERROR!
print(isinstance(l,Line))
print(isinstance(l,Geom))
print(isinstance(g,Geom))

