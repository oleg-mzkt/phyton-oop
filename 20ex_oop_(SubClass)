# Насследование классов  
# наследование происходить от базового класса
class Geom(): # базовый класс
    name = 'Имя Базового класса'
    def set_coords(self, x1, x2, y1, y2):
        self.x1 = x1
        self.x2 = x2
        self.y1 = y1 
        self.y2 = y2

class Line(Geom): # дочерний класс Line от базового Geom
    #name='Имя линия'
    def draw(self):
        print("Рисование линии")

    # def set_coords(self, x1, y1, x2, y2) - перенесли в базовый класс
    #     self.x1 = x1
    #     self.x2 = x2
    #     self.y1 = y1 
    #     self.y2 = y2

class Rectangle(Geom):  # дочерний класс Rectangle от базового Geom
    name='Имя прямоугольник' # переопределяем атрибута
    def draw(self):
        print("Рисование прямоугольника")
    
   
    # def set_coords(self, x1, y1, x2, y2) - перенесли в базовый класс
    #     self.x1 = x1
    #     self.x2 = x2
    #     self.y1 = y1 
    #     self.y2 = y2  
    
    def set_coords(self, x1, y1, x2, y2): #-переопределение метода set
        self.x1 = x1
        self.x2 = x2
        self.y1 = y1 
        self.y2 = y2

g = Geom()
l = Line()
r = Rectangle()
l.set_coords(1,1,2,2)
r.set_coords(1,1,2,2)
print(l.__dict__)
print(r.__dict__)
print(l.name)
print(r.name)
# когда происходит обращение к какому-либо атрибуту - поиск просиходит сначала в том классе в котором вызвывали, а потом если не находит то в базовом

# ---------------- 21EX_OOP --------------------
print(issubclass(Geom,object)) # ghj
print(issubclass(Line,object))
print(issubclass(Rectangle,object))
print(issubclass(Geom,Line))
