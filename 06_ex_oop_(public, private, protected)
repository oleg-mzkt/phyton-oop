#6. Режимы доступа public, private, protected. Сеттеры и геттеры | ООП Python
####1####
# public - публичный доступ к атрибутам (без подчеркиваий перед атрибутами)
####2####
# _protected - режим доступа защищённый (с одинм подчеркиванием перед атрибутами) - используется для обращения внутри класса и во всех его дочерних классах
####3####
# __private - режим доступа приватный (с двумя подчеркиваниями) используется для обращения только внутри класса

####4####
# модуль приватного доступа  pip install accessify - специально предназначен для скрытия атрибутов
# доступ извне к защищённым атрибутам может быть напрямую вот так: _Point3.__x  - это крайне не рекомендуется
# Встроенная функция dir() при вызове без аргумента, возвращает список переменных, доступных в локальной области. Если передать функции объект, она вернет список атрибутов указанного объекта.





#1 public - публичный доступ
class Point:
    
    def __init__(self,x=0,y=0):
        self.x = x
        self.y = y

pt = Point(1,2)    
pt.x=200
pt.y="coord_y"
print('pt:',pt.x,pt.y)
print('pt.__dict__:',pt.__dict__,'\n')


#2 _protected - режим доступа защищённый лишь сигнализирует программисту о том что это внутренния служебная переменная и доступ к ней может в будущем пропасть - поэтому напрямую лучше к ней не обращаться
class Point2: # если из
    
    def __init__(self,x=0,y=0):
        self._x = x
        self._y = y

pt2 = Point2(1,2)    
pt2._x=200
pt2._y="coord_y"
print('pt2:',pt2._x,pt2._y)
print('pt2.__dict__:',pt2.__dict__,'\n')



#3 private  
class Point3:
    
    def __init__(self,x=0,y=0):
        self.__x = x
        self.__y = y
    
    def get_coord(self): # интерфейсный метод для получения приватных данных экземпляра
        return self.__x,self.__y
    
    def set_coord(self,x,y): # интерфейсный метод для установки(определения) приватных данных экземпляра и проверки передаваеммых данных (проверки могут быть от различных методов и все в одном месте - это удобно)
        if type(x) in (int,float) and type(y) in (int,float): # - просто можно добавить проверку на соответствие передаваемых данных
            if self.__chek_value(x) and self.__chek_value(y): #  - таже проверка только через приватный метод класса
                self.__x = x
                self.__y = y
        else:
            raise ValueError("Координаты должны быть числами, введите допустимые значения")
    
    @classmethod        
    def __chek_value(cls,x_or_y): # - привавтный метод класса к которому нельзя обратиться извне
        return type(x_or_y) in (int,float)
        
    
pt3 = Point3(11,22)    
# print(pt3.__x,pt3.__y) # елси обратиться напрямую будет ошибка:
#>>> AttributeError: 'Point3' object has no attribute '__x'
#поэтому необходимы методы(ф-ции) get_coord(self) и set_coord(self,x,y) для определения и получения данных экземпляра.
print('pt3.__dict__:',pt3.__dict__,'\n')
print(pt3.get_coord()) # возвращает кортеж с приватными атрибутами экземпляра
#>>> 11,22
pt3.set_coord(111,222) # изменяем данные приватных атрибутов через интерфейсный метод set_coord()
print(pt3.get_coord())  # проверям реузльата
#>>> 111,222



