# 1. Множественное наследование даёт возможность классу наследовать свойства и методы более чем от одного родительского класса.
# 2. Основная проблема - когда родительские классы имеют методы или атрибуты с одинаковыми именами, но разными реализациями. 

# 3. MRO (Method Resolution Order) - __mro__() порядок поиска инициализации методов и аттрибутов в классах с множественным наследованием. Вначале идёт обращение к дочернему, далее к базовому классу дочернего, далее классы этого ранга , далее выше по рангу базового класса.

# 4. Т.е. поиск осуществляется с дочерних классах к базовым вплоть до object. 

# 5. В спомогательных базовых классах Mixinlog стараться инициализацию прописывать без параметров, а для их инициализации использовать ф-цию:
   #super().__init__()  

class Goods1():
    pass
class Goods2(Goods1):
    def __init__(self,name,weight,price):
        super().__init__() 
        print('def __init__ Goods():')
        self.name = name 
        self.weight = weight
        self.price = price

    def print_info(self):
        print(f"{self.name},{self.weight},{self.price}")

class MixinLog1():
    pass

class MixinLog2(MixinLog1): # класс создан для инициализации и множественного наследования
    ID = 0 
    def __init__(self): # ИНИЦИАЛИЗАТОР ДОЧЕРНЕГО КЛАССА СРАБОТАЕТ В ПЕРВУЮ ОЧЕРЕДЬ, А ДАЛЕЕ БУДУТ ИСКАТЬСЯ ПО ПОРЯДКУ ПО КАРТЕ __mro__
        print("def __init__ MixinLog():")
        self.ID += 1
        self.id = self.ID 
    
    def seve_sell_log(self):
        print(f"{self.id}: товар был инициализирован в 00:00 часов")

class NoteBook(Goods2,MixinLog2):
    pass

n = NoteBook('Acer',1.5,30000)
n.print_info()
n.seve_sell_log()
print(NoteBook.__mro__) # ф-ция .__mro__ показывает порядок очередности как будут искаться аттрибудты и методы в смешанном классе.

# >>> порядок будет следующий (<class '__main__.NoteBook'>, <class '__main__.Goods2'>, <class '__main__.Goods1'>, <class '__main__.MixinLog1'>, <class '__main__.MixinLog2'>, <class 'object'>)
