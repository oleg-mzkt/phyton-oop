#1. Классы и объекты. Атрибуты классов и объектов | Объектно-ориентированное программирование Python
#########1#########
#1.1) переменная в классе - это атрибут(или свойство) класса.
#1.2) обект класса - это экземпляр класса (можно создавать произвольное кол.)
#1.3) все атрибуты класса создержаться в словаре этого класса (напр. Point.__dict__)
#1.4) все атрибуты класса автоматически добавляются экземплярам класса и едины для всех (могут быть переопределены)
#1.5) атрибуты объекта могут быть собственными и могут быть переопределены(тогда становятся не общими)
##########2##########
#2.1 добавление атрибутов классу или объекту класса 
# Point.color2 = 'default' 
#     или (что одинаково)
# setattr(Класс/объект,'атрибут','значение') # ф-ция добавления или установки атрибутов
#2.2 атрибуты можно удалять как у класса так и у объекта (), но прежде чем удалять нужно проверить существует объект или нет
# del Point.color3 или  delattr(Класс/объект,'атрибут')

#2.3 удаляя переопределённый атрибут у объекта он может быть прочитан с пространства класса (если таков есть)

#2.4к переопределение(добавление) атрибутов экземпляру класса(объекту) a.color='green'

class Point:
    color = 'red' # переменная в классе - это атрибут(или свойство) класса
    сircle = 2

a=Point()   # а - экземпляр класса Point (объект 'а')
b=Point()   # b - экземпляр класса Point (объект 'b')

print(Point.__dict__) #выводит все атрибуты класса
 # >>>{'__module__': '__main__', 'color': 'red', 'сircle': 2, '__dict__': <attribute '__dict__' of 'Point' objects>, '__weakref__': <attribute '__weakref__' of 'Point' objects>, '__doc__': None}
print(a.__dict__) # >>>{} будет пустой словарь т.к. нет собственных
# >>>{}
print(a.color) # атрибуты объекта беруться из класса, если они не переопределны
# >>>red
##########2##########
#2.1
Point.color2 = 'default'
setattr(Point,'color3','green')
print('атрибуты класса:',Point.color,Point.color2,Point.color3)
a.color2 = 'yellow'
print('атрибуты объекта:', a.color,a.color2,a.color3)

#2.2
print(Point.__dict__)
del Point.сircle
print(Point.__dict__)
del Point.color2

print('атрибут объекта "а" color2 присутствует т.к. он был назначен индивидуальным (хоть и удалили color2):', a.color,a.color2,a.color3) # атрибут берётся с класса

#2.3 hasattr(Класс/объект,'атрибут'):
# проверим атрибуты объекта
print('атр."а":',hasattr(a,'color'),hasattr(a,'color2'),hasattr(a,'color3'))
#атрибут объекта а остались т.к. они были переопределены индивидуально
print("атр.Point:",hasattr(Point,'color'),hasattr(Point,'color2'),hasattr(Point,'color3'))

print(a.__dict__)
# перед тем как удалять атрибут необходимо проверить его наличие или будет ERROR
if hasattr(a,'color2'):
    del a.color2
    print ('удалён атрибут color2 объекта "а" ')

print('атр."а":',hasattr(a,'color'),hasattr(a,'color2'),hasattr(Point,'color3'))
print(a.__dict__) # словарь объекта "а" пустой  но мы можем обращаться к ним т.к. атрибуты считываются с класса этого объекта.
#>>>{}  
#2.4 переопределим общие параметры объекта "а" сделаем их индивидуальными:

if hasattr(a,'color'):
    a.color= 'white'
if hasattr(a,'color2'):
    a.color2 = 'black'
if hasattr(a,'color3'):
    a.color3 = 'red'
print(a.__dict__)
#>>> {'color': 'white', 'color3': 'red'} т.к. атрибут color2 в классе поинт не было и в объекте а тоже не было он не определился и не переназначился, но его можно всегда добавить
a.color2 = 'black'
Point.color2 = 'default'
print(a.__dict__)
print(Point.__dict__)
