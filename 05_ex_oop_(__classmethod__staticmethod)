# 1 @classmethod 
# класс-методы такие же как и другие методы класса, с тем отличем что они емеют доступ только к атрибутам класса и не иемют доступ к атрибутам экземпляров этого класса
# метод def validate(cls,arg): можно вызвывать через сам класс: Vecotr.validate(5) или через ссылку cls.validate в методах (чтобы при смене имения класса ничего не надо было менять в параметрах) 
class Vector():
    
    MIN_COORD = 0
    MAX_COORD = 100
    
    @classmethod # 
    def validate(cls,arg): # статический метод класса который просто делает проверку попадает ли координато в диапазон 0 - 100.
        return cls.MIN_COORD <= arg <= cls.MAX_COORD # возвращает True or False
        
    def __init__(self,x,y):
        self.x = self.y = 0 
        if Vector.validate(x) and cls.validate(y): # более правильно и универсально вызывать статик метод через ссылу на класс cls - т.е. cls.validate(y) хотя и через Имя класса тоже можно Vector.validate(x).
            # если проверка прошла изменяем значения, если нет x и y = 0
            print(f'проверка пройдена\nx = {x},\ny = {y}')
            self.x = x
            self.y = y
        else:
             print(f'проверка не пройдена\nx = {x}\ny = {y}\nкоординаты не применены')
        
    def get_coord(self):
        return self.x, self.y
    
v = Vector(1,200)
result = Vector.get_coord(v)
print(result)
