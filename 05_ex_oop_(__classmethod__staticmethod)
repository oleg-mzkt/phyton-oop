#5. Методы класса (classmethod) и статические методы (staticmethod) | ООП Python

# 1 @classmethod 
# Метод класса в Python — это метод, который привязан к классу, а не к его экземпляру. Он может изменять состояние класса, но не может изменять состояние конкретного экземпляра класса.

# класс-методы такие же как и другие методы класса, с тем отличем что они емеют доступ только к атрибутам класса и не иемют доступ к атрибутам экземпляров этого класса
# метод def validate(cls,arg): можно вызвывать через сам класс: Vecotr.validate(5) или через ссылку cls.validate в методах (чтобы при смене имения класса ничего не надо было менять в параметрах) 

#2Статический метод - это метод, который НЕ привязан к состоянию экземпляра ИЛИ класса.  Используется в качестве вспомогательной функции и может быть вызван через имя класса или его экземпляр с произвольными параметрами.
#@staticmethod - статические методы предполагается использовать только с темы параметрами которые в них прописаны (x и y например), хотя через Имя класса можно обращаться и к атрибутам класса но это не рекомендуется
 
 # Итог если предпологается исопльзовать Атрибуты класса - используем  @classmethod, если используются параметры экземпляра для доп.вычислений или операци - используем @staticmethod


class Vector():
    
    MIN_COORD = 0
    MAX_COORD = 100
    
    #####1#####
    @classmethod  
    def validate(cls,arg): # @classmethod который просто делает проверку попадает ли координато в диапазон 0 - 100.
        return cls.MIN_COORD <= arg <= cls.MAX_COORD # возвращает True or False
        
    def __init__(self,x,y):
        self.x = self.y = 0
        if self.validate(x) and Vector.validate(y): # более правильно и универсально вызывать @classmethod через ссылу на класс self - т.е. self.validate(y) хотя и через Имя класса тоже можно Vector.validate(x).
            # если проверка прошла изменяем значения, если нет x и y = 0
            print(f'проверка пройдена\nx = {x},\ny = {y}')
            self.x = x
            self.y = y
            print(self.norm2(self.x,self.y))
        else:
             print(f'проверка не пройдена\nx = {x}\ny = {y}\nкоординаты не применены')
        
        
    def get_coord(self):
        return self.x, self.y
        
    
    #####2#####  - статический метод который может вызван через имя класса
    @staticmethod # используется для удобства 
    def norm2(x,y): # вычисление квадрат нормы через использование вспомогательной функции для произвольных координат
        return x*x + y*y
    

v = Vector(1,20)
result = Vector.get_coord(v)
print(result)
print(Vector.norm2(5,6))
