#2. Методы классов. Параметр self | Объектно-ориентированное программирование Python
# атрибуты класса - это его свойства (переменные)
# методы класса - это его функции(определенные действия),
# определяются как def метод(self):


######## 1 ######### self
class Point:
    color = 'red'
    circle = 2 
    
    def set_coords(self): # если self не прописывать как параметр, пайтон автоматически будет вызывать метод класса из которого он вызывался
        print('вызов метода "set_coords()"'+ str(self))

print(type(Point.set_coords)) # вызов функции
#>>><class 'function'>

Point.set_coords(Point) # параметр self показывает откуда вызывается метод

#создадим объект класса Point
pt=Point()
print(type(pt)) 
#<class '__main__.Point'>

#########2########### вызво методов класса у объектов этого класса
print(str(pt)) # объект клааса поинт с ссылкой по адресу 0x7f0abcc85dc0
pt.set_coords() # параметр self подставляется автоматически, если у объекта нет такого метода этот метод вызывается из класса этого объекта автоматически
