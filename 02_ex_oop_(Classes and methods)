#2. Методы классов. Параметр self | Объектно-ориентированное программирование Python
# атрибуты класса - это его свойства (переменные)
# методы класса - это его функции(определенные действия),
# определяются как def метод(self):
# имена метотодов - это тоже атрибуты класса и поэтому мы можем получить доступ к методам через getattr(),hasattr(),delattr()

######## 1 ######### self
class Point:
    color = 'red'
    circle = 2 
    
    def set_coords(self,x,y): # если self не прописывать как параметр, пайтон автоматически будет вызывать метод класса из которого он вызывался
        self.x=x
        self.y=y
        print('вызов метода "set_coords()"'+ str(self))
        
    def get_coords(self):
        return (self.x, self.y)
    

print(type(Point.set_coords)) # вызов функции
#>>><class 'function'>

Point.set_coords(Point,'z','z') # параметр self показывает откуда вызывается метод, пара метры x,y если они определены в методе тоже обязательны 

#создадим объект класса Point
pt=Point()
print(type(pt)) 
#<class '__main__.Point'>

#########2########### вызво методов класса у объектов этого класса
print(str(pt)) # объект клааса поинт с ссылкой по адресу 0x7f0abcc85dc0
pt.set_coords('1','2') # параметр self подставляется автоматически, этот метод вызывается из класса этого объекта автоматически
print(pt.__dict__)
pt2=Point()
print(pt2.__dict__)
pt2.set_coords(10,22)
print(pt2.__dict__)
print('pt2.get_coords:',pt2.get_coords())

print('вызовем метод get_coords для pt2:', pt2.get_coords())
#del Point.get_coords # удалив метод класса мы не можем уже к ниму обратиться - будет
#print('вызовем метод get_coords для pt2:', pt2.get_coords())
#>>> будет ошибка т.к. был удалён метод get_coords в Point

