#3. Инициализатор __init__ и финализатор __del__ | Объектно-ориентированное программирование Python
#Магическими методами называют методы, имена которых начинаются и заканчиваются двойным подчеркиванием.

class Point:
    color = 'red'
    circle = 2 

    def set_coords(self,x,y):
        self.x=x
        self.y=y

    def get_coords(self,x,y):
        return self.x, self.y

#########1######### __init__(self) -  маг метод вызывается сразу после создания объекта
#
    # def __init__(self) # если аргументов нет можно не указывать во время создания объекта pt=Point() 
    # def __init__(self,x,y) # нужно обязательно указывать параметры во время создания обхекта  т.е. pt=Point(10,20) или pt=Point(x=10,y=20)
    # def __init__(self,x=0,y=0) # тогда при создании объекта не обязательно указывать параметры

    def __init__(self,x,y): # при инициализации можно автоматически назначать параметры объекта перед созданием объекта во время инициализации 
        print('вызов __init__')
        self.x=x
        self.y=y

#########2######### __del__(self)
# удаление объектов происходит с помощью сборщика мусора (алгоритм отслеживает когда на объект не видёт ни одна внешняя ссыла и сборщик мусора автоматические его удалит - освободит память)
# т.е. магический метод __del__ вызывается пока ещё существует объект, но после его вызова объект гарантированно удаляется
    def __del__(self): 
        print('вызов __del__ - Удаление экземпляра класса' + repr(self))

pt=Point(x=10,y=20) #  можно писать сразу Point(10,20)
print(pt.__dict__)
pt.set_coords(1,2)
print(pt.__dict__)
