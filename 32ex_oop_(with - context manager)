#32. Менеджеры контекстов. Оператор with | Объектно-ориентированное программирование Python
# Context manager (менедж контекста) - это класс, в котором реализовано 2-а основных метода:
# __enter__() - срабатывает в момент создания объекта менедж. контекста
# __exit__() - срабатывает в момент завершения работы менедж. контекста или возникновения исключения = отрабатывает как метод finally:
#  Конструкция менеджера контекста это:
#a)     with <менеджер контекста> as <переменная>: 
#             список конструкций языка Python
#b)или  with <менеджер контекста>:(без as <переменная>)- тогда мы не сможем работать с самим объектом <менеджера контекста>

#1) работа с файлом  с помощью менедж. контекста 
#2) работа со списком  с помощью менедж. контекста 


########### 1 ###########
# без менеджера контекста
fp = None 
try:
    fp = open("myfile.txt")  # открываем файл
    for i in fp:             # читаем данные с файла
        print(i)              
except Exception as e:       # если произошли ошибки 
    print(e)                 # выводим ошибку
finally:                     # блок finally выполняется в любом случае
    if fp is not None:       # если файл был открыт 
        fp.close()           # закрываем его
        
# с менеджером контекста
fp = None 
try:
    with open("myfile.txt") as fp:  # открывася файл и закрывается автоматически независимо от ошибок
        for i in fp:         # читаем данные с файла
            print(i)                      
except Exception as e:       # если произошли ошибки 
    print(e)                 # выводим ошибку
                             
  ########### 2 ###########  
  # Пример своего класса менеджера контекста
  # - будем складывать 2 вектора с помощью менеджера контекста,только в том случае если не произошло ошибок, а если были ошибки - изменений вноситься не будут.
  
class DefenedVector: # класс для создания копии списка складываемого вектора v1
    def __init__(self, v): # инициализация
        self.__v = v
    
    def __enter__(self):  # метод отрабатывается в момент создания менедж.конт. 
        self.__temp = self.__v[:] # тут создаётся копия списка v1
#        print(self.__v,"self.__v")
        return self.__temp # копия возвращается
        
    def __exit__(self, exc_type, exc_val, exc_tb): # метод отрабатывает всегда независмо от возникших ошибок 
    #exc_type - тип исключения
    #exc_val - значение исключения
    #exc_tb - трасировка исключения
        if exc_type is None: # если exc_type == None ошибки не происходили
            self.__v[:] = self.__temp
            print("ошибки не происходили")
        else:
            print("ошибки происходили")
        return 1 # если поставить False то исключения вознишие в менедж.контекста обрабатываться НЕ БУДУТ - мы дальше обрабатываем try-except
                 # если поставить True - оператор with будет подавлять возникающие исключения внутри себя и продолжит выполнение с оператора т.е. блок в try-except не сработает ошибка строка 62 

v1 = [1,2,3]
v2 = [1,2]

try:                                # try-except ввели для проверки 
    with DefenedVector(v1) as dv:   # переменная dv ссылается на копию списка v1 (т.е. на self.__temp)
        for i, a in enumerate(dv):  #enumerate() - возвращает не только индекс "i" но и значение "а"
            dv[i] += v2[i]          # вектор v2[i]  - имеет только 2 элемента dv[i]  имеет 3 элемента
except:                             # возникнет исключение т.к. у складываемых списках разное кол. элем
    print("ошибка")                 # будет ошибка  (TypeError: list indices out of range) 

print(v1,"вектор не изменился если возникли ошибки")                           # но вектор v1 не изменнится  

######### если эти операции делать без менеджера контекста - то получим: ######
try:
    for i, a in enumerate(v1):
        v1[i] += v2[i] 
        
except:
    print("ошибка")
print(v1, "вектор изменяется без контекст менеджера даже если появилась ошибка")
