#32. Менеджеры контекстов. Оператор with | Объектно-ориентированное программирование Python
#1) работа с файлом - открывая файловый поток (ф-ция open) по окончанию желательно закрыть файл
#2) работа со списком
#

########### 1 ###########
fp = None 
try:
    fp = open("myfile.txt")
    for t in fp:
        print(t)
except Exception as e:
    print(e)
finally:
    if fp is not None:
        fp.close()
